[
  {
    "name": "no_tool",
    "body": {
      "model": "gpt-4.1",
      "messages": [
        {"role": "system", "content": "You are Pi Gateway demo."},
        {"role": "user", "content": "Hello"}
      ],
      "temperature": 0
    }
  },
  {
    "name": "single_tool",
    "body": {
      "model": "gpt-4.1",
      "messages": [
        {"role": "system", "content": "You can call tools."},
        {"role": "user", "content": "Read workspace/test.txt"}
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "read_file",
            "description": "Read a file",
            "parameters": {
              "type": "object",
              "properties": {"path": {"type": "string"}},
              "required": ["path"]
            }
          }
        }
      ],
      "tool_choice": "auto"
    }
  },
  {
    "name": "tool_result_round",
    "body": {
      "model": "gpt-4.1",
      "messages": [
        {"role": "system", "content": "Summarize tool results."},
        {"role": "user", "content": "Read workspace/test.txt"},
        {
          "role": "assistant",
          "content": null,
          "tool_calls": [
            {
              "id": "call_demo",
              "type": "function",
              "function": {"name": "read_file", "arguments": "{\"path\":\"test.txt\"}"}
            }
          ]
        },
        {"role": "tool", "tool_call_id": "call_demo", "content": "test"}
      ]
    }
  }
]
